@model EventoVM

<label>Nombre Evento</label>
<p>@Model.NombreEvento</p>

<label> Fecha Evento</label>
<p>@Model.FechaEvento</p>

<a asp-controller="Asistente" asp-action="AgregarAEvento" asp-route-IdEvento="@Model.IdEvento">Agregar Asistente</a>

<ul>
@{
    foreach(var nombre in Model.NombresAsistentes)
    {

        <li>@nombre</li>
    
    }

    }
</ul>